rules_version = '2';

// Security rules for the APX GP website.
// Paste this whole file into Firebase Console → Firestore Database → Rules → Publish.
//
// What they enforce:
//  • Anyone can create an account; it only gets a small profile (name, email).
//  • Only admins (listed in /admins) can see the account list, grant or remove
//    admin access, or read the stored GitHub publishing token.
//  • The very first admin is added by hand in the Firebase console.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // Who is an admin.
    match /admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list, create, update: if isAdmin();
      allow delete: if isAdmin() && request.auth.uid != uid; // you can't remove yourself
    }

    // The GitHub token the admin console uses to publish. Admins only.
    match /secrets/{doc} {
      allow read, write: if isAdmin();
    }

    // Account profiles (name + email), so admins can find people to promote.
    match /users/{uid} {
      function owner() { return signedIn() && request.auth.uid == uid; }
      allow get: if owner() || isAdmin();
      allow list: if isAdmin();
      allow create: if owner()
        && request.resource.data.keys().hasOnly(['username', 'email', 'created'])
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 1 && request.resource.data.username.size() <= 32;
      allow update: if owner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username']);
      allow delete: if isAdmin();
    }

    // Everything else (including leftovers from the old card packs) is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
